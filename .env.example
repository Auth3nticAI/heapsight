# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Judge0 (C++ compilation)
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# AI Tutor (Groq - free tier: 14,400 requests/day)
GROQ_API_KEY=gsk_your_key_here
USE_OLLAMA=false
OLLAMA_ENDPOINT=http://localhost:11434

# Polar (payments - https://polar.sh/dashboard)
POLAR_ACCESS_TOKEN=polar_oat_your_access_token
POLAR_WEBHOOK_SECRET=polar_wh_your_webhook_secret
POLAR_PRODUCT_ID_MONTHLY=your_monthly_product_id
POLAR_PRODUCT_ID_YEARLY=your_yearly_product_id
POLAR_SERVER=sandbox

# Supabase Service Role (for Polar webhook)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PostHog Analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=http://localhost:3000
